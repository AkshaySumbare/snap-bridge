# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Cookies (web auth)
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/snapbridge?retryWrites=true&w=majority

# Redis Cloud — use the URL from dashboard (NOT the redis-cli command)
REDIS_URL=redis://default:<password>@<host>.cloud.redislabs.com:<port>

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth (Web application credentials from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Must go through the Vite dev proxy so cookies are set on localhost:5173
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
GOOGLE_OAUTH_SUCCESS_REDIRECT=http://localhost:5173/dashboard

# Password reset token TTL in seconds (default 1 hour)
PASSWORD_RESET_TTL_SECONDS=3600

# Frontend URL (used in password reset emails)
FRONTEND_URL=http://localhost:5173

# Resend — https://resend.com/onboarding
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=SnapBridge <onboarding@resend.dev>

# Cloudinary — https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Rate limiting
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_API_WINDOW_MS=900000
RATE_LIMIT_API_MAX=100

# ── Vault + Semantic Search (Phase 2) ──────────────────────────────────────

# OpenAI — embeddings + optional answer generation
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key

# Embedding model (default: text-embedding-3-small, 1536 dimensions)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Chat model for /api/vault/ask answers
CHAT_MODEL=gpt-4o-mini

# Text chunking
VAULT_CHUNK_SIZE=800
VAULT_CHUNK_OVERLAP=100

# Max upload size in bytes (default 10MB)
VAULT_MAX_FILE_BYTES=10485760

# OCR for images/screenshots (set false to skip tesseract)
VAULT_OCR_ENABLED=true

# MongoDB Atlas vector search index name (create in Atlas UI — see backend/docs/vault-api.md)
VECTOR_SEARCH_INDEX_NAME=chunk_embedding_index
VECTOR_SEARCH_NUM_CANDIDATES=100
VECTOR_SEARCH_LIMIT=8

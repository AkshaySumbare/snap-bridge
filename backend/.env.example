# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Cookies (web auth)
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/snapbridge?retryWrites=true&w=majority

# Redis Cloud — use the URL from dashboard (NOT the redis-cli command)
REDIS_URL=redis://default:<password>@<host>.cloud.redislabs.com:<port>

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth (Web application credentials from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Must go through the Vite dev proxy so cookies are set on localhost:5173
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
GOOGLE_OAUTH_SUCCESS_REDIRECT=http://localhost:5173/dashboard

# Password reset token TTL in seconds (default 1 hour)
PASSWORD_RESET_TTL_SECONDS=3600

# Rate limiting
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_API_WINDOW_MS=900000
RATE_LIMIT_API_MAX=100
